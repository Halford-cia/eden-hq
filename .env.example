# Eden HQ browser build configuration. Copy to .env.local for local
# development (ignored by git). In Netlify, set these two as project
# environment variables instead. These are the ONLY values the browser build
# may read; `npm run build` refuses anything else.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<from Supabase: Project Settings, API Keys>

# Local Supabase CLI only (supabase/config.toml reads these). Never in Netlify.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=<development OAuth client id>
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=<development OAuth client secret>

# check:public (local runs): a deny-list file OUTSIDE this repository.
# EDEN_DENYLIST_FILE=/path/outside/the/repo/eden-denylist.txt
